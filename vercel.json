{
    "buildCommand": "mkdir -p dist && echo ok > dist/index.html",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4",
            "maxDuration": 60
        }
    },
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_NAME": "Rental Mobil",
        "APP_ENV": "production",
        "APP_DEBUG": "true",
        "CACHE_DRIVER": "array",
        "SESSION_DRIVER": "cookie",
        "SESSION_SECURE_COOKIE": "true",
        "QUEUE_CONNECTION": "sync",
        "BROADCAST_DRIVER": "log",
        "LOG_CHANNEL": "stderr",
        "LOG_DEPRECATIONS_CHANNEL": "null",
        "FILESYSTEM_DISK": "local",
        "STORAGE_DISK": "supabase",
        "DB_CONNECTION": "pgsql",
        "DB_SSLMODE": "require"
    }
}
