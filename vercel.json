{
    "buildCommand": "mkdir -p dist && echo ok > dist/index.html && (composer dump-autoload -o || true) && (php artisan route:cache || true)",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4",
            "maxDuration": 60
        }
    },
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_NAME": "Rental Mobil",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "CACHE_DRIVER": "array",
        "SESSION_DRIVER": "cookie",
        "SESSION_SECURE_COOKIE": "true",
        "QUEUE_CONNECTION": "sync",
        "BROADCAST_DRIVER": "log",
        "LOG_CHANNEL": "stderr",
        "LOG_DEPRECATIONS_CHANNEL": "null",
        "FILESYSTEM_DISK": "local",
        "STORAGE_DISK": "supabase",
        "DB_CONNECTION": "pgsql",
        "DB_HOST": "aws-0-ap-northeast-2.pooler.supabase.com",
        "DB_PORT": "5432",
        "DB_DATABASE": "postgres",
        "DB_USERNAME": "postgres.yieiodexjlvghufrsoku",
        "DB_SSLMODE": "require"
    }
}
